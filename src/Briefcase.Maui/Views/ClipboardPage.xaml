<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:vm="clr-namespace:Briefcase.Maui.ViewModels"
             xmlns:models="clr-namespace:Briefcase.Maui.Models"
             xmlns:controls="clr-namespace:Briefcase.Maui.Controls"
             x:Class="Briefcase.Maui.Views.ClipboardPage"
             x:DataType="vm:ClipboardViewModel"
             Title="Briefcase">

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="0">

        <!-- Category Filter Tabs -->
        <ScrollView Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,8,12,8"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <Label Text="All"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                       VerticalOptions="Center"/>
                <Label Text="Favorites"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center"/>
                <Label Text="Files"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center"/>
                <Label Text="Links"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center"/>
                <Label Text="Notes"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Grouped message list -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True"
                        Margin="12,4,12,0">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:MessageGroup">
                    <Border Style="{StaticResource SectionHeaderPill}"
                            Margin="0,6,0,2">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource SectionHeaderLabel}"/>
                    </Border>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MockMessage">
                    <controls:MessageCardView/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,60"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image Source="icon_clipboard.png"
                           HeightRequest="44"
                           WidthRequest="44"
                           Opacity="0.5"/>
                    <Label Text="Nothing here yet"
                           Style="{StaticResource HeadingLabel}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Items you save will appear in this list."
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Capture Anything panel -->
        <VerticalStackLayout Grid.Row="2"
                             Margin="12,8,12,8"
                             Spacing="6">
            <Label Text="CAPTURE ANYTHING"
                   Style="{StaticResource CaptureHeading}"/>

            <Border Style="{StaticResource CapturePanel}">
                <Editor Placeholder="Type or paste something…"
                        Text="{Binding Draft}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="50"
                        FontSize="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"/>
            </Border>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <ImageButton Grid.Column="0"
                             Source="icon_paperclip.png"
                             WidthRequest="20"
                             HeightRequest="20"
                             Padding="0"
                             BackgroundColor="Transparent"/>
                <Button Grid.Column="1"
                        Text="Save"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveMessageCommand}"
                        HeightRequest="36"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
