<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Briefcase.Maui.ViewModels"
             x:Class="Briefcase.Maui.Views.TransferPage"
             x:DataType="vm:TransferViewModel"
             Title="Transfer">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20"
                    Spacing="18"
                    MaximumWidthRequest="480"
                    HorizontalOptions="Center">

                <!-- Tabs -->
                <Grid ColumnDefinitions="*,*"
                        ColumnSpacing="0"
                      Padding="4"
                      HeightRequest="48">
                    <Grid.Background>
                        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}"/>
                    </Grid.Background>
                    <Button Grid.Column="0"
                            Text="To device"
                            CornerRadius="8"
                            Command="{Binding ShowDeviceTabCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                    Binding="{Binding IsDeviceTab}"
                                    Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                <Setter Property="FontAttributes"
                                        Value="Bold"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="By link"
                            CornerRadius="8"
                            Command="{Binding ShowLinkTabCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                    Binding="{Binding IsLinkTab}"
                                    Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"/>
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                <Setter Property="FontAttributes"
                                        Value="Bold"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- To device -->
                <VerticalStackLayout Spacing="16"
                        IsVisible="{Binding IsDeviceTab}">
                    <Label Text="Send to a device"
                            Style="{StaticResource HeadingLabel}"
                            HorizontalTextAlignment="Center"/>
                    <Label Text="Enter the code shown on the receiving device."
                           Style="{StaticResource SecondaryLabel}"
                            HorizontalTextAlignment="Center"/>

                    <Border Style="{StaticResource Card}"
                            Padding="12,4">
                        <Entry Placeholder="ABCD1234"
                                Text="{Binding EnteredCode}"
                               HorizontalTextAlignment="Center"
                                FontSize="22"
                                CharacterSpacing="6"
                               Style="{StaticResource FormEntry}"/>
                    </Border>
                    <Button Text="Send"
                            Style="{StaticResource PrimaryButton}"/>

                    <BoxView HeightRequest="1"
                            Margin="0,4"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

                    <Label Text="Or receive on this device"
                            Style="{StaticResource SectionLabel}"
                            HorizontalOptions="Center"/>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6"
                                HorizontalOptions="Center">
                            <Label Text="Your code"
                                    Style="{StaticResource MutedLabel}"
                                    HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding ReceiveCode}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    CharacterSpacing="4"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                            <Label Text="Enter this on another device to send here."
                                    Style="{StaticResource MutedLabel}"
                                    HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- By link -->
                <VerticalStackLayout Spacing="16"
                        IsVisible="{Binding IsLinkTab}">
                    <Label Text="Share by link"
                            Style="{StaticResource HeadingLabel}"
                            HorizontalTextAlignment="Center"/>
                    <Label Text="Create a public link anyone can open in a browser."
                           Style="{StaticResource SecondaryLabel}"
                            HorizontalTextAlignment="Center"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Link expires"
                                Style="{StaticResource FormLabel}"/>
                        <Border Style="{StaticResource Card}"
                                Padding="12,2">
                            <Picker ItemsSource="{Binding ExpiryOptions}"
                                    SelectedItem="{Binding SelectedExpiry}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                                Text="Self-destruct after first open"
                                VerticalOptions="Center"/>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding SelfDestruct}"
                                OnColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                    </Grid>

                    <Button Text="Generate link"
                            Style="{StaticResource PrimaryButton}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
