<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Briefcase.Maui.ViewModels"
             xmlns:models="clr-namespace:Briefcase.Maui.Models"
             x:Class="Briefcase.Maui.Views.DevicesPage"
             x:DataType="vm:DevicesViewModel"
             Title="Devices">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16"
                    Spacing="14"
                    MaximumWidthRequest="720"
                    HorizontalOptions="Fill">

                <Label Text="Devices"
                        Style="{StaticResource TitleLabel}"/>
                <Label Text="Manage the devices signed in to your account."
                        Style="{StaticResource SecondaryLabel}"/>

                <FlexLayout Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center">
                    <Button Text="Generate pair code"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,4,8,4"/>
                    <Button Text="Scan code"
                            Style="{StaticResource OutlineButton}"
                            Margin="0,4,8,4"/>
                    <Button Text="Add device"
                            Style="{StaticResource OutlineButton}"
                            Margin="0,4,8,4"/>
                </FlexLayout>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Devices}"
                        Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:MockDevice">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0"
                                            Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}"
                                                    FontAttributes="Bold"
                                                    FontSize="16"
                                                    VerticalOptions="Center"/>
                                            <Border Style="{StaticResource Badge}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentBgLight}, Dark={StaticResource AccentBgDark}}">
                                                <Label Text="{Binding PlatformLabel}"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}"
                                                    IsVisible="{Binding IsCurrent}"
                                                    BackgroundColor="{StaticResource FileBadgeBg}">
                                                <Label Text="This device"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource FileBadgeText}"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding LastSeenLabel}"
                                                Style="{StaticResource MutedLabel}"/>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Remove"
                                            Style="{StaticResource OutlineButton}"
                                            HeightRequest="38"
                                            Padding="14,0"
                                            IsEnabled="{Binding IsCurrent, Converter={x:Static vm:InverseBoolConverter.Instance}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
