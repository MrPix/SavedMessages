<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Briefcase.Maui.Models"
             x:Class="Briefcase.Maui.Controls.MessageCardView"
             x:DataType="models:MockMessage">

    <Border Style="{StaticResource Card}"
            Margin="0,3"
            Padding="12">

        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">

            <!-- Icon in 34x34 rounded surface-hover box -->
            <Border Grid.Column="0"
                    WidthRequest="34"
                    HeightRequest="34"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHoverLight}, Dark={StaticResource SurfaceHoverDark}}"
                    Padding="5"
                    VerticalOptions="Start">
                <Image Source="{Binding IconSource}"
                       WidthRequest="22"
                       HeightRequest="22"/>
            </Border>

            <!-- Content: timestamp, primary text, comment -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2">
                <Label Text="{Binding TimeLabel}"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"/>
                <Label Text="{Binding PrimaryText}"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       MaxLines="3"/>
                <Label Text="{Binding FileComment}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       IsVisible="{Binding HasComment}"/>
            </VerticalStackLayout>

            <!-- Pinned star, accent color when pinned -->
            <Image Grid.Column="2"
                   Source="icon_star.png"
                   WidthRequest="16"
                   HeightRequest="16"
                   VerticalOptions="Start"
                   IsVisible="{Binding IsPinned}"/>
        </Grid>
    </Border>
</ContentView>
